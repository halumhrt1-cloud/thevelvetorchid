---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
	<section class="hero">
		<h1>🌿 Welcome to The Velvet Orchid</h1>
		<p class="tagline">
			Cozy home ideas, plant care tips, and slow-living inspiration —
			one warm corner at a time.
		</p>
	</section>
	<section class="intro">
		<p>
			The Velvet Orchid is a little corner of the internet for anyone who loves
			a well-tended home and a thriving houseplant collection. Expect practical
			plant care guides, seasonal decor ideas, and gentle reminders to slow down
			and enjoy the small stuff.
		</p>
		<p>
			New posts drop regularly — browse the latest below, or head to the
			<a href="/blog">blog</a> to see everything.
		</p>
	</section>
</main>
		<Footer />
	</body>
<style>
	.hero {
		text-align: center;
		padding: 3em 1em 2em;
	}
	.hero h1 {
		margin-bottom: 0.3em;
	}
	.tagline {
		font-size: 1.3em;
		color: rgb(var(--gray-dark));
		max-width: 560px;
		margin: 0 auto;
	}
	.intro {
		max-width: 680px;
		margin: 2em auto;
		padding: 1.5em;
		background: white;
		border-radius: 20px;
		box-shadow: var(--box-shadow);
	}
	.intro a {
		font-weight: 600;
	}
</style>
</html>
